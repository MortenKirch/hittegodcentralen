# Copy to .env.local for local development, and set the same variables at your host
# (e.g. Vercel → Settings → Environment Variables). Values are in Supabase → Project Settings → API Keys.

# Public — sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_.
# Used to create items (app/opret/actions.ts).
SUPABASE_SECRET_KEY=sb_secret_...
